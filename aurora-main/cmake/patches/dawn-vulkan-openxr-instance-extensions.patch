index e0ea4da..f6b360d 100644
--- a/src/dawn/native/vulkan/VulkanExtensions.h
+++ b/src/dawn/native/vulkan/VulkanExtensions.h
@@ -52,6 +52,13 @@ enum class InstanceExt : uint32_t {
     DebugUtils,
