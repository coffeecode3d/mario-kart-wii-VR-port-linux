+    // the get_physical_device_properties2 extension, so it must come first (dependency order).
+    GetPhysicalDeviceProperties2,
+    ExternalFenceCapabilities,
+    ExternalMemoryCapabilities,
+    ExternalSemaphoreCapabilities,
+
     EnumCount,
 };
 
